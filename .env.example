# Supabase Configuration
# Substitua pelos valores reais do seu projeto Supabase
NEXT_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co
# Current Supabase key format
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_your-key
SUPABASE_SECRET_KEY=sb_secret_your-key
# Legacy key format, supported as fallback
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key-here
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here
NEXT_PUBLIC_REMOTE_DATA_ENABLED=false

# Remote media (Supabase metadata + Google Drive files)
NEXT_PUBLIC_REMOTE_MEDIA_ENABLED=false
# Authentication option 1: service account (preferred with a Shared Drive)
GOOGLE_SERVICE_ACCOUNT_EMAIL=service-account@project.iam.gserviceaccount.com
GOOGLE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"
# GOOGLE_SERVICE_ACCOUNT_PRIVATE_KEY is also accepted as a key alias.
# Authentication option 2: OAuth user account (use all three values)
GOOGLE_OAUTH_CLIENT_ID=your-oauth-client-id.apps.googleusercontent.com
GOOGLE_OAUTH_CLIENT_SECRET=your-oauth-client-secret
GOOGLE_OAUTH_REFRESH_TOKEN=your-oauth-refresh-token
GOOGLE_DRIVE_FOLDER_ID=your-root-folder-id
# Optional when the folder belongs to a Shared Drive
GOOGLE_DRIVE_ID=your-shared-drive-id

# Payment Gateway (Optional)
# ASAAS_API_KEY=your-asaas-key
